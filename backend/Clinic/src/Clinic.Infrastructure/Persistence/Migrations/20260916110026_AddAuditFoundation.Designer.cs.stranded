            modelBuilder.Entity("Clinic.Domain.Entities.Prescription", b =>
                {
                    b.Navigation("Items");
                });

            modelBuilder.Entity("Clinic.Domain.Entities.Visit", b =>
                {
                    b.Navigation("Amendments");

                    b.Navigation("VitalMeasurements");
                });
#pragma warning restore 612, 618
        }
    }
}
