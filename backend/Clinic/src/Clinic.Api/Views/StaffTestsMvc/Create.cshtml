@model StaffTestCreatePage
@{ ViewData["Title"] = T["Create"]; }
<partial name="_Patient" model="Model.Patient" />
<a asp-action="Index" asp-route-patientId="@Model.Patient.PatientId" asp-route-culture="@T.Culture">@T["Back"]</a>
<h1 class="mt-3 mb-4">@T["Create"]</h1>
<form method="post" asp-action="Create" asp-route-patientId="@Model.Patient.PatientId" asp-route-culture="@T.Culture" class="card p-4 form-panel" data-single-submit>
    <input type="hidden" name="SubmissionToken" value="@Model.SubmissionToken" />
    <div asp-validation-summary="All" class="text-danger" role="alert"></div>
    <div class="mb-3"><label for="Category" class="form-label">@T["Category"]</label><select id="Category" name="Category" class="form-select" required>
        @foreach (var category in Enum.GetValues<ClinicalTestCategory>()) { <option value="@category">@T[category.ToString()]</option> }
    </select></div>
    <div class="mb-3"><label for="TestName" class="form-label">@T["TestName"]</label><input id="TestName" name="TestName" class="form-control" maxlength="200" required dir="auto" autocomplete="off" /></div>
    @if (Model.Visits.Count > 0) {
        <div class="mb-3"><label for="VisitId" class="form-label">@T["Visit"] · @T["Optional"]</label>
            <select id="VisitId" name="VisitId" class="form-select" aria-describedby="visit-hint"><option value="">@T["Standalone"]</option>
                @foreach (var visit in Model.Visits) { <option value="@visit.Id">@T.Date(visit.OccurredAtUtc)</option> }
            </select><div id="visit-hint" class="form-text">@T["VisitHint"]</div></div>
    }
    else { <p class="text-secondary">@T["NoVisits"]</p> }
    <div class="mb-4"><label for="ClinicalInstructions" class="form-label">@T["Instructions"] · @T["Optional"]</label>
        <textarea id="ClinicalInstructions" name="ClinicalInstructions" rows="4" maxlength="2000" class="form-control" dir="auto"></textarea></div>
    <div class="d-flex gap-3 align-items-center"><button class="btn btn-primary" type="submit">@T["CreateSubmit"]</button>
        <a asp-action="Index" asp-route-patientId="@Model.Patient.PatientId" asp-route-culture="@T.Culture">@T["Cancel"]</a></div>
</form>
