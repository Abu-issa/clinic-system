@model StaffTestDetailPage
@{
    ViewData["Title"] = T["Tests"];
    var d = Model.Test;
    var token = Convert.ToBase64String(d.RowVersion ?? []);
    var returnUrl = Url.Action("Detail", new { patientId = Model.Patient.PatientId, requestId = d.Id, culture = T.Culture });
}
<partial name="_Patient" model="Model.Patient" />
<a asp-action="Index" asp-route-patientId="@Model.Patient.PatientId" asp-route-culture="@T.Culture">@T["Back"]</a>
<div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mt-3 mb-4">
    <div><h1><bdi>@d.TestName</bdi></h1><span class="text-secondary">@T[d.Category.ToString()]</span></div>
    <span class="status-badge status-@d.Status">@T[d.Status.ToString()]</span>
</div>
<section class="card p-4 mb-4">
    <dl class="row mb-0">
        <div class="col-md-4"><dt>@T["RequestedAt"]</dt><dd><bdi>@T.Date(d.RequestedAtUtc)</bdi></dd></div>
        <div class="col-md-4"><dt>@T["UploadedAt"]</dt><dd><bdi>@T.Date(d.UploadedAtUtc)</bdi></dd></div>
        <div class="col-md-4"><dt>@T["ReviewedAt"]</dt><dd><bdi>@T.Date(d.ReviewedAtUtc)</bdi></dd></div>
        @if (!string.IsNullOrWhiteSpace(d.ClinicalInstructions)) { <div class="col-12 mt-3"><dt>@T["Instructions"]</dt><dd class="clinical-text" dir="auto">@d.ClinicalInstructions</dd></div> }
    </dl>
</section>
<section class="card p-4 mb-4" aria-labelledby="results-heading">
    <h2 id="results-heading">@T["Results"] <span class="text-secondary">(@d.ResultAttachmentCount)</span></h2>
    @if (Model.Attachments is null) { <p class="mb-0">@T["HiddenAttachments"]</p> }
    else if (Model.Attachments.Count == 0) { <p class="mb-0">@T["NoResults"]</p> }
    else {
        <p class="text-secondary">@T["DownloadHint"]</p>
        <div class="table-responsive"><table class="table align-middle mb-0">
            <caption class="visually-hidden">@T["Results"]</caption>
            <thead><tr><th scope="col">@T["Name"]</th><th scope="col">@T["Type"]</th><th scope="col">@T["Size"]</th><th scope="col">@T["CreatedAt"]</th><th scope="col">@T["Download"]</th></tr></thead>
            <tbody>@foreach (var file in Model.Attachments) {
                <tr><th scope="row"><bdi>@file.OriginalFileName</bdi></th><td><bdi>@file.ContentType</bdi></td><td><bdi>@T.Size(file.SizeBytes)</bdi></td><td><bdi>@T.Date(file.CreatedAtUtc)</bdi></td>
                    <td><a href="/api/staff/patients/@Model.Patient.PatientId/attachments/@file.AttachmentId/download?ui=staff&amp;culture=@T.Culture" aria-label="@T["Download"] @file.OriginalFileName">@T["Download"]</a></td></tr>
            }</tbody>
        </table></div>
    }
</section>
@if (Model.CanUpload) {
    <section class="card p-4 mb-4" aria-labelledby="upload-heading">
        <h2 id="upload-heading">@T["Upload"]</h2>
        <p id="upload-hint">@T["UploadHint"] <bdi>@T.Size(Model.MaxFileSizeBytes)</bdi></p>
        <form method="post" enctype="multipart/form-data" asp-action="Upload" asp-route-patientId="@Model.Patient.PatientId" asp-route-requestId="@d.Id" asp-route-culture="@T.Culture"
              data-upload data-return-url="@returnUrl" data-error="@T["500"]" data-csrf="@T["Csrf"]" data-denied="@T["403"]" data-signin="@T["401"]" data-unavailable="@T["404"]" data-large="@T["TooLarge"]" data-sending="@T["Sending"]">
            <input type="hidden" name="expectedRowVersion" value="@token" />
            <label for="result-file" class="form-label">@T["File"]</label>
            <input id="result-file" class="form-control mb-3" type="file" name="file" accept=".pdf,.jpg,.jpeg,.png,application/pdf,image/jpeg,image/png" required aria-describedby="upload-hint" />
            <button type="submit" class="btn btn-primary" disabled data-upload-button>@T["Upload"]</button>
            <p role="alert" class="mt-3 mb-0" data-upload-error></p>
            <p role="status" class="mt-3 mb-0" data-upload-unavailable>@T["UploadJs"]</p>
        </form>
    </section>
}
@if (Model.CanReview && d.Status is ClinicalTestStatus.Uploaded or ClinicalTestStatus.UnderReview) {
    var complete = d.Status == ClinicalTestStatus.UnderReview;
    <section class="card p-4 mb-4">
        <h2>@T[complete ? "CompleteReview" : "StartReview"]</h2>
        @if (complete) { <p>@T["CompleteHint"]</p> }
        <form method="post" asp-action="@(complete ? "CompleteReview" : "StartReview")" asp-route-patientId="@Model.Patient.PatientId" asp-route-requestId="@d.Id" asp-route-culture="@T.Culture" data-single-submit>
            <input type="hidden" name="expectedRowVersion" value="@token" />
            <button type="submit" class="btn btn-primary">@T[complete ? "CompleteReview" : "StartReview"]</button>
        </form>
    </section>
}
@if (d.Status == ClinicalTestStatus.Reviewed) { <p class="alert alert-secondary">@T["Locked"]</p> }
<a href="@returnUrl">@T["Refresh"]</a>
