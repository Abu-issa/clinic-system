### Doctor + prescriptions.write + patient scope + doctor authority + CSRF.
# The route prescription is the CANCELLED original; creates exactly one replacement Draft.
POST {{StaffHost}}/api/staff/patients/{{PatientId}}/prescriptions/{{PrescriptionId}}/replacement
Content-Type: application/json
Cookie: {{StaffCookie}}; {{CsrfCookie}}
X-CSRF-TOKEN: {{CsrfToken}}

{
  "notes": "Replacement draft",
  "expectedOriginalRowVersion": "{{OriginalPrescriptionRowVersion}}"
}
