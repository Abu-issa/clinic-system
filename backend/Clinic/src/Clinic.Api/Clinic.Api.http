@Clinic.Api_HostAddress = http://localhost:5043

GET {{Clinic.Api_HostAddress}}/weatherforecast/
Accept: application/json

###

# Development examples only. Replace IDs/date/start/version and supply an existing
# staff cookie and CSRF token using the real authentication flow below.
# See docs/staff-authentication.md. Use HTTPS and an ephemeral cookie-aware client.
# Never save actual passwords, shared keys, recovery codes or cookie/token values here.
@StaffHost = https://localhost:7152
@DoctorId = 00000000-0000-0000-0000-000000000001
@PatientId = 00000000-0000-0000-0000-000000000002
@AppointmentId = 00000000-0000-0000-0000-000000000003
@LocalDate = 2030-01-07
@StartUtc = 2030-01-07T06:00:00Z
@EndUtc = 2030-01-07T06:30:00Z
@StaffCookie = REPLACE_WITH_EXISTING_STAFF_COOKIE
@CsrfCookie = REPLACE_WITH_EXISTING_ANTIFORGERY_COOKIE
@CsrfToken = REPLACE_WITH_EXISTING_CSRF_TOKEN
@RowVersion = REPLACE_WITH_CURRENT_BASE64_VERSION

### Obtain a CSRF token before anonymous login. Keep the returned cookie.
GET {{StaffHost}}/api/staff/auth/csrf

### Password step. Supply StaffUserName/StaffPassword only in an ephemeral client;
# these sensitive variables are deliberately not defined in this file.
# Use the requestToken from /csrf. Keep the returned intermediate cookie and csrfToken.
POST {{StaffHost}}/api/staff/auth/login
Content-Type: application/json
X-CSRF-TOKEN: {{CsrfToken}}

{
  "userName": "{{StaffUserName}}",
  "password": "{{StaffPassword}}"
}

### Only when login returns next=enrollment. Client must retain intermediate cookie.
POST {{StaffHost}}/api/staff/auth/enrollment/setup
X-CSRF-TOKEN: {{CsrfToken}}

### Enter secret in authenticator, then verify. Save returned recovery codes offline once.
POST {{StaffHost}}/api/staff/auth/enrollment/verify
Content-Type: application/json
X-CSRF-TOKEN: {{CsrfToken}}

{ "code": "{{AuthenticatorCode}}" }

### Subsequent password login returns next=totp. No remember-device option exists.
POST {{StaffHost}}/api/staff/auth/totp
Content-Type: application/json
X-CSRF-TOKEN: {{CsrfToken}}

{ "code": "{{AuthenticatorCode}}" }

### Alternative second factor after password verification; consumes one recovery code.
POST {{StaffHost}}/api/staff/auth/recovery
Content-Type: application/json
X-CSRF-TOKEN: {{CsrfToken}}

{ "code": "{{RecoveryCode}}" }

### Minimal full session details. Refresh /csrf whenever the browser identity changes.
GET {{StaffHost}}/api/staff/auth/session

### Clears cookies and revokes all sessions for this account.
POST {{StaffHost}}/api/staff/auth/logout
X-CSRF-TOKEN: {{CsrfToken}}

### Explicit account-wide revocation, requiring a full MFA session.
POST {{StaffHost}}/api/staff/auth/revoke-sessions
X-CSRF-TOKEN: {{CsrfToken}}

### Advisory availability; requires appointments.availability and doctor scope.
GET {{StaffHost}}/api/staff/doctors/{{DoctorId}}/availability?date={{LocalDate}}&appointmentType=Consultation
Cookie: __Host-Clinic.Staff={{StaffCookie}}

### New booking: end time is derived by the server. Also supports FollowUp.
POST {{StaffHost}}/api/staff/appointments
Content-Type: application/json
Cookie: __Host-Clinic.Staff={{StaffCookie}}; __Host-Clinic.Antiforgery={{CsrfCookie}}
X-CSRF-TOKEN: {{CsrfToken}}

{
  "patientId": "{{PatientId}}",
  "doctorId": "{{DoctorId}}",
  "startsAt": "{{StartUtc}}",
  "appointmentType": "Consultation"
}

### Read current appointment times/type/version; requires rescheduling permission.
GET {{StaffHost}}/api/staff/doctors/{{DoctorId}}/appointments/{{AppointmentId}}/rescheduling
Cookie: __Host-Clinic.Staff={{StaffCookie}}

### Uses stored duration/type and excludes only this authorized appointment.
GET {{StaffHost}}/api/staff/doctors/{{DoctorId}}/appointments/{{AppointmentId}}/rescheduling/availability?date={{LocalDate}}
Cookie: __Host-Clinic.Staff={{StaffCookie}}

### EndsAt must preserve the stored duration, even if policy duration has changed.
POST {{StaffHost}}/api/staff/doctors/{{DoctorId}}/appointments/{{AppointmentId}}/rescheduling
Content-Type: application/json
Cookie: __Host-Clinic.Staff={{StaffCookie}}; __Host-Clinic.Antiforgery={{CsrfCookie}}
X-CSRF-TOKEN: {{CsrfToken}}

{
  "startsAt": "{{StartUtc}}",
  "endsAt": "{{EndUtc}}",
  "reason": "Patient requested a different time",
  "expectedRowVersion": "{{RowVersion}}"
}

### Patient administrative creation. Requires patients.admin.write; synthetic example only.
POST {{StaffHost}}/api/staff/patients
Content-Type: application/json
Cookie: {{StaffCookie}}; {{CsrfCookie}}
X-CSRF-TOKEN: {{CsrfToken}}

{
  "fullName": "Synthetic example",
  "phoneNumber": "synthetic-shared",
  "medicalRecordNumber": "SYN-EXAMPLE",
  "legacyPaperFileNumber": "PAPER-EXAMPLE",
  "dateOfBirth": null
}

### Requires patients.admin.read and the explicit patient_record_id scope.
GET {{StaffHost}}/api/staff/patients/{{PatientId}}
Cookie: {{StaffCookie}}

### Administrative update: current Patient RowVersion, not profile RowVersion.
PUT {{StaffHost}}/api/staff/patients/{{PatientId}}
Content-Type: application/json
Cookie: {{StaffCookie}}; {{CsrfCookie}}
X-CSRF-TOKEN: {{CsrfToken}}

{
  "fullName": "Synthetic example updated",
  "phoneNumber": "synthetic-shared",
  "dateOfBirth": null,
  "emergencyContactName": null,
  "emergencyContactPhone": null,
  "emergencyContactRelation": null,
  "expectedRowVersion": "{{RowVersion}}"
}

### Doctor/DoctorAssistant + patients.clinical.read + patient scope.
GET {{StaffHost}}/api/staff/patients/{{PatientId}}/medical-profile
Cookie: {{StaffCookie}}

### Doctor + patients.clinical.write + patient scope; FIRST profile save only.
# Complete snapshot: all lists required. On later saves include every retained entry ID
# and the current profile RowVersion. To remove entries, list their IDs in supersededEntryIds;
# omission alone is rejected. Include every basic/value field, using null for an intentional clear.
PUT {{StaffHost}}/api/staff/patients/{{PatientId}}/medical-profile
Content-Type: application/json
Cookie: {{StaffCookie}}; {{CsrfCookie}}
X-CSRF-TOKEN: {{CsrfToken}}

{
  "bloodType": null,
  "allergyStatus": 0,
  "smokingStatus": null,
  "diabetesType": null,
  "allergies": [],
  "chronicConditions": [],
  "medications": [],
  "surgeries": [],
  "familyHistory": [],
  "expectedRowVersion": null
}
